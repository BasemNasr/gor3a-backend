# ==============================================================================
# Prescription AI Lab - Environment Configuration
# ==============================================================================

# AI Vision Providers (Set at least one)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Provider & Model
# Options for provider: "gemini", "openai", "claude"
# Options for model:
#   Gemini: "gemini-2.5-flash", "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.0-flash"
#   OpenAI: "gpt-4o", "gpt-4o-mini"
#   Claude: "claude-3-5-sonnet-20241022", "claude-3-5-haiku-20241022"
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# CORS Configuration (JSON array or comma-separated)
CORS_ORIGINS=*

# Prompt Version Path (relative to project root)
PROMPT_PATH=prompts/prescription_analysis_v1.txt

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==============================================================================
# Supabase Cloud Database (Free PostgreSQL Storage)
# ==============================================================================
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
